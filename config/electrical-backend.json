{
  "schema": 1,
  "active": "atopile",
  "contract": {
    "candidate_root": "build/03-electrical/tmp",
    "required_artifacts": [
      "candidate_board",
      "build_receipt"
    ],
    "optional_artifacts_are_backend_private": true,
    "freeze_receipt_kind": "electrical_freeze",
    "freeze_bundle_root": "build/04-electrical-freeze/release",
    "physical_manifest_schema": 2,
    "invariant": "Reviewed atopile source is the production electrical authority. Backends generate isolated candidates and must never overwrite a reviewed physical board."
  },
  "backends": {
    "atopile": {
      "driver": "scripts/build_atopile_isolated.py",
      "source_root": "src",
      "entry": "main.ato:App",
      "runtime": "wsl-ato",
      "platform": "wsl-native",
      "distro": "Ubuntu-24.04",
      "network_mode": "direct",
      "status": "primary"
    },
    "tscircuit": {
      "driver": "scripts/build_tscircuit_isolated.py",
      "source_root": "tscircuit",
      "entry": "src/main.tsx",
      "runtime": "bun",
      "platform": "windows-native",
      "status": "experimental"
    }
  }
}
