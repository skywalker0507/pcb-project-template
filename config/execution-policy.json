{
  "schema": 1,
  "activation": {
    "default": false,
    "requires_explicit_whole_stage_scope": true,
    "examples": [
      "继续直到完成整个阶段",
      "自行完成整个 stage",
      "continue until the whole stage is complete"
    ],
    "does_not_activate": [
      "bounded implementation request",
      "routine autonomy within the requested task",
      "stage status is in_progress"
    ]
  },
  "continuation": {
    "statuses": [
      "in_progress"
    ],
    "candidate_result_is_turn_boundary": false,
    "candidate_rejection_is_blocker": false,
    "handoff_is_turn_boundary": false,
    "elapsed_time_is_completion_evidence": false
  },
  "final_reasons": {
    "stage_complete": {
      "statuses": [
        "complete",
        "completed"
      ],
      "requires_empty_next_actions": true,
      "requires_verified_handoff": true
    },
    "blocked": {
      "statuses": [
        "blocked",
        "blocked_external_dependency"
      ],
      "minimum_observations": 3,
      "requires_safe_alternatives_exhausted": true,
      "required_evidence_fields": [
        "condition",
        "why_user_input_required"
      ]
    },
    "user_decision": {
      "requires_material_decision_flag": true,
      "requires_detail": true
    },
    "user_stopped": {
      "requires_detail": true
    }
  },
  "gate_command": "py -3.14 scripts/check_turn_exit.py --continuous-scope"
}
